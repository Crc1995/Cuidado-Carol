<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#FCE4EC" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1A0F15" media="(prefers-color-scheme: dark)">
<title>Cuidados Carol</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg1:#FFF6F9;--bg2:#FBDDE8;--texto:#3F1D2B;--suave:rgba(63,29,43,.62);--sup:rgba(255,255,255,.72);--sup-solida:#FFF;--borda:rgba(255,255,255,.75);--sombra:0 8px 30px rgba(194,24,91,.12);--sakura:#E75480;--sakura2:#C2185B;--verde:#22C55E}
@media (prefers-color-scheme:dark){:root{--bg1:#1A0F15;--bg2:#2A1420;--texto:#FCE7EF;--suave:rgba(252,231,239,.62);--sup:rgba(40,20,30,.72);--sup-solida:#2A1621;--borda:rgba(255,255,255,.08);--sombra:0 8px 30px rgba(0,0,0,.35)}.fundo{opacity:.45}.avatar{color:#F8BBD0!important}}
body{min-height:100vh;display:flex;justify-content:center;padding:32px 16px 48px;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:linear-gradient(170deg,var(--bg1),var(--bg2)) fixed;color:var(--texto);overflow-x:hidden;-webkit-tap-highlight-color:transparent}

/* Fundo: flores desabrochando e pétalas caindo */
.fundo{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.flor-bg{position:absolute;left:var(--x);top:var(--y);width:var(--s);height:var(--s);opacity:0;animation:desabrochar var(--d) ease-in-out var(--a) infinite}
@keyframes desabrochar{0%{transform:scale(0) rotate(-60deg);opacity:0}25%{transform:scale(1) rotate(0);opacity:.6}75%{transform:scale(1) rotate(15deg);opacity:.6}100%{transform:scale(.6) rotate(30deg);opacity:0}}
.petala{position:absolute;top:-30px;left:var(--x);width:var(--t);height:calc(var(--t)*.8);background:radial-gradient(circle at 30% 30%,#FFE4EC,#F8A5C2 70%);border-radius:150% 0 150% 0;opacity:.8;animation:cair var(--d) linear var(--a) infinite}
@keyframes cair{0%{transform:translate(0,0) rotate(0)}25%{transform:translate(30px,27vh) rotate(90deg)}50%{transform:translate(-20px,55vh) rotate(180deg)}75%{transform:translate(25px,82vh) rotate(270deg)}100%{transform:translate(-10px,110vh) rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.flor-bg{animation:none;opacity:.4}.petala{display:none}}

/* Estrutura */
.pagina{position:relative;z-index:1;width:100%;max-width:460px;display:flex;flex-direction:column;gap:14px}
.vidro{background:var(--sup);border:1px solid var(--borda);box-shadow:var(--sombra);-webkit-backdrop-filter:blur(16px) saturate(140%);backdrop-filter:blur(16px) saturate(140%)}
header{text-align:center;padding:8px 0 10px}
.emblema{width:72px;height:72px;margin:0 auto 12px;border-radius:24px;display:grid;place-items:center;font-size:2.2rem;background:linear-gradient(135deg,#FFD1E0,#F48FB1);box-shadow:0 10px 24px rgba(231,84,128,.35)}
h1{font-size:2rem;font-weight:800;letter-spacing:-.02em}
.subtitulo{margin-top:4px;color:var(--suave)}

/* Botão ligar */
.ligar{width:100%;display:flex;align-items:center;gap:16px;padding:22px;border:none;border-radius:28px;background:linear-gradient(135deg,#F472A6 0%,var(--sakura) 45%,var(--sakura2) 100%);color:#FFF;font:inherit;text-align:left;cursor:pointer;box-shadow:0 14px 30px rgba(194,24,91,.35);transition:transform .12s}
.ligar:active{transform:scale(.98)}
.ligar-icone{position:relative;flex-shrink:0;width:64px;height:64px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.22)}
.ligar-icone::after{content:"";position:absolute;inset:0;border-radius:50%;border:2px solid rgba(255,255,255,.6);animation:pulso 2.2s ease-out infinite}
@keyframes pulso{from{transform:scale(1);opacity:.8}to{transform:scale(1.5);opacity:0}}
.ligar-texto{flex:1}
.ligar-texto strong{display:block;font-size:2rem;font-weight:800}
.ligar-texto span{font-size:.95rem;opacity:.9}
.chevron{display:grid;transition:transform .3s}
.aberto>button .chevron{transform:rotate(180deg)}

/* Abre e fecha animado */
.expansivel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s ease}
.aberto>.expansivel{grid-template-rows:1fr}
.expansivel>div{overflow:hidden}

/* Contatos */
.lista-contatos{display:flex;flex-direction:column;gap:10px;padding-top:12px}
.contato{display:flex;align-items:center;gap:14px;padding:12px 12px 12px 14px;border-radius:20px;color:var(--texto);text-decoration:none;transition:transform .12s}
.contato:active{transform:scale(.98)}
.avatar{flex-shrink:0;width:50px;height:50px;border-radius:50%;display:grid;place-items:center;font-size:1.3rem;font-weight:800;color:var(--sakura2);background:color-mix(in srgb,var(--sakura) 18%,transparent)}
.contato-info{flex:1;min-width:0}
.contato-info strong{display:block;font-size:1.2rem}
.contato-info span{color:var(--suave)}
.botao-tel{flex-shrink:0;width:50px;height:50px;border-radius:50%;display:grid;place-items:center;background:var(--verde);color:#FFF;box-shadow:0 6px 14px rgba(34,197,94,.35)}

/* Categorias */
.card{border-radius:24px;overflow:hidden}
.card-topo{width:100%;display:flex;align-items:center;gap:14px;padding:16px 18px;border:none;background:none;color:var(--texto);font:inherit;text-align:left;cursor:pointer}
.badge{flex-shrink:0;width:46px;height:46px;border-radius:14px;display:grid;place-items:center;font-size:1.4rem;background:color-mix(in srgb,var(--c) 16%,transparent)}
.card-titulo{flex:1;font-size:1.25rem;font-weight:700}
.contagem{min-width:28px;padding:2px 10px;border-radius:99px;background:var(--c);color:#FFF;font-size:.85rem;font-weight:700;text-align:center}
.card-topo .chevron{color:var(--c)}
.card ul{list-style:none;display:flex;flex-direction:column;gap:8px;padding:0 16px 16px}
.card li{display:flex;gap:12px;padding:12px 14px;border-radius:16px;background:color-mix(in srgb,var(--c) 8%,var(--sup-solida))}
.ponto{flex-shrink:0;width:10px;height:10px;margin-top:7px;border-radius:50%;background:var(--c)}
.card li strong{display:block;font-size:1.1rem}
.card li small{display:block;margin-top:2px;font-size:.92rem;line-height:1.4;color:var(--suave)}
.acoes{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.acao{display:inline-flex;padding:6px 12px;border-radius:99px;background:var(--c);color:#FFF;font-size:.88rem;font-weight:700;text-decoration:none}

/* Rodapé */
.samu{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:6px;padding:14px;border-radius:18px;color:var(--texto);font-weight:700;text-decoration:none}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <radialGradient id="gp" cx="50%" cy="100%" r="100%"><stop offset="0" stop-color="#F48FB1"/><stop offset=".55" stop-color="#FFC1D6"/><stop offset="1" stop-color="#FFF0F5"/></radialGradient>
  <symbol id="sakura" viewBox="-50 -50 100 100">
    <g fill="url(#gp)" stroke="#F48FB1" stroke-width=".8">
      <path id="pt" d="M0 -4 C-20 -14 -20 -40 -7 -46 L0 -39 L7 -46 C20 -40 20 -14 0 -4Z"/>
      <use href="#pt" transform="rotate(72)"/><use href="#pt" transform="rotate(144)"/>
      <use href="#pt" transform="rotate(216)"/><use href="#pt" transform="rotate(288)"/>
    </g>
    <circle r="7" fill="#F8BBD0"/>
    <g fill="#C2185B"><circle cy="-11" r="1.8"/><circle cx="10.5" cy="-3.4" r="1.8"/><circle cx="6.5" cy="8.9" r="1.8"/><circle cx="-6.5" cy="8.9" r="1.8"/><circle cx="-10.5" cy="-3.4" r="1.8"/></g>
  </symbol>
</defs></svg>

<div class="fundo" id="fundo" aria-hidden="true"></div>

<main class="pagina">
  <header>
    <div class="emblema">🌸</div>
    <h1>Cuidados Carol</h1>
    <p class="subtitulo">Informações importantes e contato rápido</p>
  </header>

  <section>
    <button class="ligar" aria-expanded="false">
      <span class="ligar-icone" id="iconeLigar"></span>
      <span class="ligar-texto"><strong>Ligar</strong><span>Toque para escolher o contato</span></span>
      <span class="chevron" id="chevronLigar"></span>
    </button>
    <div class="expansivel"><div><div class="lista-contatos" id="contatos"></div></div></div>
  </section>

  <div id="categorias" style="display:flex;flex-direction:column;gap:14px"></div>

  <a class="samu vidro" href="tel:192">🚑 Emergência: SAMU 192</a>
</main>

<script>
/* ===================== DADOS — edite aqui ===================== */
const CONTATOS = [
  { nome: "Claudinei", telefone: "(49) 98417-3283" },
  { nome: "Luzanira",  telefone: "(19) 99257-7356" },
  { nome: "Vladimir",  telefone: "(19) 99257-7357" },
  { nome: "Willy",     telefone: "(19) 99269-7691" }
];

const CATEGORIAS = [
  { titulo: "Alergias", icone: "⚠️", cor: "#E53935", itens: [
    { nome: "Frutos do mar" },
    { nome: "Iodo" },
    { nome: "Ácido salicílico" },
    { nome: "AAS", detalhe: "Ácido acetilsalicílico (ex.: Aspirina)" },
    { nome: "Dipirona", detalhe: "Ex.: Novalgina" }
  ]},
  { titulo: "Remédios", icone: "💊", cor: "#D81B60", itens: [
    { nome: "Puran T4", detalhe: "Levotiroxina" },
    { nome: "Cerazette", detalhe: "Desogestrel" },
    { nome: "Vitamina D" },
    { nome: "Glifage", detalhe: "Metformina" }
  ]},
  { titulo: "Histórico", icone: "📋", cor: "#8E24AA", itens: [
    { nome: "PTI que evoluiu para PTT", detalhe: "Púrpura trombocitopênica imune → púrpura trombocitopênica trombótica" },
    { nome: "Problema de tireoide", detalhe: "Em tratamento com Puran T4" }
  ]},
  { titulo: "Sinais de plaquetopenia", icone: "🩸", cor: "#F4511E", itens: [
    { nome: "O que é", detalhe: "Plaquetas baixas no sangue. O sangue coagula menos e surgem sangramentos com facilidade." },
    { nome: "Petéquias", detalhe: "Pontinhos vermelhos ou roxos na pele que não somem ao apertar. Aparecem mais nas pernas." },
    { nome: "Manchas roxas", detalhe: "Hematomas sem batida, ou maiores que o normal para a batida." },
    { nome: "Sangramento na gengiva ou no nariz", detalhe: "Que aparece sozinho ou demora a parar." },
    { nome: "Sangue na urina ou nas fezes", detalhe: "Urina avermelhada ou escura; fezes pretas ou com sangue." },
    { nome: "Menstruação muito intensa", detalhe: "Mais forte ou mais longa que o habitual." },
    { nome: "⚠️ Sinais de gravidade (PTT)", detalhe: "Confusão, fala enrolada, dor de cabeça forte, fraqueza de um lado do corpo, febre, pele ou olhos amarelados, falta de ar." },
    { nome: "O que fazer", detalhe: "Ir ao pronto-socorro ou ligar 192 na hora e avisar que ela tem histórico de PTT. Não dar AAS nem anti-inflamatórios (como ibuprofeno)." }
  ]},
  { titulo: "Endereços", icone: "📍", cor: "#1E88E5", mapa: true, itens: [
    { nome: "Casa", detalhe: "Rua Gentil Martins, 40, Apartamento 21, Torre 19, Indaiatuba - SP" },
    { nome: "Casa 2", detalhe: "Rua Hermínio Steffen, 472, Jardim Regina, Indaiatuba - SP" }
  ]},
  { titulo: "Locais de referência", icone: "🏥", cor: "#00897B", mapa: true, itens: [
    { nome: "Centro Médico Campinas", detalhe: "R. Dr. Edilberto Luís Pereira da Silva, 929 - Cidade Universitária, Campinas - SP, 13083-190", telefone: "(19) 3789-5300" },
    { nome: "Laboratório Edna", detalhe: "R. Cerqueira César, 1032 - Centro, Indaiatuba - SP, 13330-005", telefone: "(19) 99310-9634" }
  ]}
];
/* ============================================================== */

const ICONE_TEL = '<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>';
const CHEVRON = '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>';

const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const digitos = t => (t || "").replace(/\D/g, "");

function linkTel(t) {
  const d = digitos(t);
  if (d.length === 10 || d.length === 11) return "+55" + d;
  return (t.trim().startsWith("+") ? "+" : "") + d;
}

function formatar(t) {
  const d = digitos(t);
  if (d.length === 11) return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
  if (d.length === 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
  return t;
}

// Botão ligar e contatos
document.getElementById("iconeLigar").innerHTML = ICONE_TEL;
document.getElementById("chevronLigar").innerHTML = CHEVRON;
document.getElementById("contatos").innerHTML = CONTATOS.map(c => `
  <a class="contato vidro" href="tel:${linkTel(c.telefone)}">
    <span class="avatar">${esc(c.nome.charAt(0))}</span>
    <span class="contato-info"><strong>${esc(c.nome)}</strong><span>${esc(formatar(c.telefone))}</span></span>
    <span class="botao-tel">${ICONE_TEL}</span>
  </a>`).join("");

// Botões de ligar e mapa dentro dos itens
function acoes(item, cat) {
  const botoes = [];
  if (item.telefone) {
    botoes.push(`<a class="acao" href="tel:${linkTel(item.telefone)}">📞 ${esc(formatar(item.telefone))}</a>`);
  }
  if (cat.mapa) {
    const busca = encodeURIComponent(item.detalhe || item.nome);
    botoes.push(`<a class="acao" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=${busca}">📍 Abrir no mapa</a>`);
  }
  return botoes.length ? `<div class="acoes">${botoes.join("")}</div>` : "";
}

// Categorias
document.getElementById("categorias").innerHTML = CATEGORIAS.map(cat => `
  <section class="card vidro" style="--c:${cat.cor}">
    <button class="card-topo" aria-expanded="false">
      <span class="badge">${cat.icone}</span>
      <span class="card-titulo">${esc(cat.titulo)}</span>
      <span class="contagem">${cat.itens.length}</span>
      <span class="chevron">${CHEVRON}</span>
    </button>
    <div class="expansivel"><div><ul>
      ${cat.itens.map(i => `
        <li><span class="ponto"></span><div>
          <strong>${esc(i.nome)}</strong>
          ${i.detalhe ? `<small>${esc(i.detalhe)}</small>` : ""}
          ${acoes(i, cat)}
        </div></li>`).join("")}
    </ul></div></div>
  </section>`).join("");

// Abrir e fechar
document.addEventListener("click", e => {
  const botao = e.target.closest(".ligar, .card-topo");
  if (!botao) return;
  const aberto = botao.parentElement.classList.toggle("aberto");
  botao.setAttribute("aria-expanded", aberto);
});

// Fundo animado
(function () {
  const r = (a, b) => a + Math.random() * (b - a);
  let html = "";
  for (let i = 0; i < 14; i++) {
    const d = r(8, 14);
    html += `<svg class="flor-bg" style="--x:${r(-5, 92)}%;--y:${r(-5, 92)}%;--s:${r(40, 110)}px;--d:${d}s;--a:${-r(0, d)}s"><use href="#sakura"/></svg>`;
  }
  for (let i = 0; i < 10; i++) {
    const d = r(11, 18);
    html += `<span class="petala" style="--x:${r(0, 95)}%;--t:${r(10, 16)}px;--d:${d}s;--a:${-r(0, d)}s"></span>`;
  }
  document.getElementById("fundo").innerHTML = html;
})();
</script>
</body>
</html>
